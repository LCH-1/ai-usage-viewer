{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Usage Viewer",
  "version": "0.1.4",
  "identifier": "com.lch1.aiusageviewer",
  "build": {
    "beforeDevCommand": "corepack pnpm run frontend:dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "corepack pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Usage Viewer",
        "width": 520,
        "height": 780,
        "minWidth": 420,
        "minHeight": 620,
        "backgroundColor": "#070809",
        "visible": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "both",
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
