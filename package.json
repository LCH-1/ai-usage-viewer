{
  "name": "ai-usage-viewer",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-account usage dashboard for Claude, Codex, and Cursor",
  "author": "LCH-1",
  "license": "MIT",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "pnpm run build:electron && concurrently -k \"vite\" \"tsc -p electron/tsconfig.json --watch\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build:electron": "tsc -p electron/tsconfig.json",
    "typecheck": "tsc --noEmit && tsc -p electron/tsconfig.json --noEmit",
    "test": "vitest",
    "build": "tsc --noEmit && tsc -p electron/tsconfig.json --noEmit && vitest run && vite build && tsc -p electron/tsconfig.json",
    "package": "node tools/generate-icon.cjs && corepack pnpm run build && node tools/run-electron-builder.cjs",
    "package:store": "node tools/generate-icon.cjs && corepack pnpm run build && node tools/run-electron-builder-store.cjs",
    "preview": "vite preview"
  },
  "dependencies": {},
  "devDependencies": {
    "@vitejs/plugin-react": "latest",
    "vite": "latest",
    "react": "latest",
    "react-dom": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "concurrently": "latest",
    "cross-env": "latest",
    "electron": "latest",
    "electron-builder": "latest",
    "typescript": "latest",
    "vitest": "latest",
    "wait-on": "latest"
  },
  "build": {
    "appId": "com.lch1.aiusageviewer",
    "productName": "Usage Viewer",
    "asar": true,
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "appx": {
      "applicationId": "AIUsageViewer",
      "identityName": "LCH-1.AIUsageViewer",
      "publisher": "CN=3A4B4FB3-AF33-49D4-89DF-BE4A32F19AF3",
      "publisherDisplayName": "LCH-1",
      "displayName": "AI Usage Viewer",
      "languages": [
        "ko-KR",
        "en-US"
      ],
      "backgroundColor": "#0B0F0D",
      "artifactName": "AI-Usage-Viewer-Store-${version}-${arch}.${ext}"
    },
    "nsis": {
      "artifactName": "Usage-Viewer-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "Usage-Viewer-Portable-${version}-${arch}.${ext}"
    }
  },
  "packageManager": "pnpm@10.15.1"
}
