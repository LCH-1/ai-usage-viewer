{
  "name": "ai-usage-viewer",
  "version": "0.1.4",
  "private": true,
  "description": "Multi-account usage dashboard for Claude, Codex, and Cursor",
  "author": "LCH-1",
  "license": "MIT",
  "scripts": {
    "dev": "tauri dev",
    "frontend:dev": "vite",
    "typecheck": "tsc --noEmit",
